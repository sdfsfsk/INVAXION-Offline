!/tools/LiveLogReader.cs
!/tools/test-live-log.ps1
!/tools/find-game.ps1
!/tools/prepare-patch.ps1
!/tools/test-prepare-patch.ps1

.venv/
__pycache__/
*.pyc
*.dll
*.exe
*.log
*.tmp
.env
.env.*
